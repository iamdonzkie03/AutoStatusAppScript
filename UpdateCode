/**
 * PROCUREMENT AUTO STATUS / VALIDATOR
 * Target sheet: Data List
 *
 * PERFORMANCE-OPTIMIZED VERSION
 *
 * Run setupValidator() ONCE after installing/updating this code.
 *
 * Main improvements:
 * - Installable validatorOnEdit is the single automatic status-processing path.
 * - No full-sheet status refresh on every open.
 * - Batched row reads and status writes.
 * - No per-cell getDisplayValue() calls during status calculation/validation.
 * - Only edited rows are processed on edit.
 * - Daily trigger refreshes date-dependent statuses once per day.
 * - Short lock prevents overlapping edits from racing each other.
 *
 * Status rules:
 * - ACTIVE: core procurement fields complete; eligibility/submission are today or later.
 * - CLOSED: core procurement fields complete; eligibility/submission are both before today.
 * - AWARDED: downstream award fields complete; Supplier required.
 * - FAILED: downstream award fields complete; Supplier NOT required.
 * - PURCHASE ORDER: all PO fields complete; TOTAL ABC = 0; PR TOTAL ABC = 0; PO TOTAL COST > 0.
 * - CANCELLED PO: all PO fields complete; TOTAL ABC = 0; PR TOTAL ABC = 0; PO TOTAL COST = 0.
 * - CANCELLED PR: PR TOTAL ABC = 0 and Remarks = Cancelled PR.
 * - REALIGNED ITEM: ONLY TOTAL ABC = 0 AND Remarks contains "realign".
 */

const CONFIG = {
  SHEET_NAME: 'Data List',
  HEADER_ROW: 1,
  STATUS_HEADER: 'STATUS',
  DATE_FORMAT: 'MMMM d, yyyy',
  MAX_ERRORS_DISPLAYED: 100,
  LOCK_TIMEOUT_MS: 1500
};

const PHILGEPS_REQUIRED_FIELD = 'PHILGEPS REFERENCE NO.';

const CORE_FIELDS = [
  'PRE-PROCUREMENT CONFERENCE',
  'POSTING DATE',
  'PROJECT ID',
  'PRE-BID CONFERENCE',
  'ELIGIBILITY SCREENING',
  'SUBMISSION OF BIDS',
  'PROCUREMENT METHOD',
  'PROJECT TITLE',
  PHILGEPS_REQUIRED_FIELD
];

const AWARDED_FIELDS = CORE_FIELDS.concat([
  'DETAILED BID EVALUATION',
  'POST-QUALIFICATION',
  'BAC RESOLUTION NO.',
  'NOA DATE',
  'SUPPLIER'
]);

const FAILED_FIELDS = [
  PHILGEPS_REQUIRED_FIELD,
  'PRE-PROCUREMENT CONFERENCE',
  'POSTING DATE',
  'PRE-BID CONFERENCE',
  'ELIGIBILITY SCREENING',
  'SUBMISSION OF BIDS',
  'DETAILED BID EVALUATION',
  'POST-QUALIFICATION',
  'NOA DATE',
  'BAC RESOLUTION NO.'
];

const PO_FIELDS = AWARDED_FIELDS.concat([
  'TOTAL ABC',
  'PR TOTAL ABC',
  'NTP DATE',
  'PO NO.',
  'DATE PREPARED (PO)',
  'PO TOTAL COST'
]);

const DATE_FIELDS = [
  'PRE-PROCUREMENT CONFERENCE',
  'POSTING DATE',
  'PRE-BID CONFERENCE',
  'ELIGIBILITY SCREENING',
  'SUBMISSION OF BIDS',
  'DETAILED BID EVALUATION',
  'POST-QUALIFICATION',
  'NOA DATE',
  'NTP DATE',
  'DATE PREPARED (PO)'
];

const NUMERIC_FIELDS = [
  'TOTAL ABC',
  'PR TOTAL ABC',
  'PHILGEPS REFERENCE NO.',
  'PO TOTAL COST'
];

/**
 * Run once after installing/updating the code.
 * Removes old validator triggers and creates exactly:
 *   1. installable onEdit
 *   2. installable onOpen
 *   3. daily time-driven refresh
 */
function setupValidator() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw new Error('No active spreadsheet found.');

  const sheet = ss.getSheetByName(CONFIG.SHEET_NAME);
  if (!sheet) {
    throw new Error('Sheet "' + CONFIG.SHEET_NAME + '" was not found.');
  }

  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    const fn = trigger.getHandlerFunction();

    // Remove every trigger created by older versions of this validator.
    if (
      fn === 'validatorOnEdit' ||
      fn === 'validatorOnOpen' ||
      fn === 'validatorDailyRefresh' ||
      fn === 'onEdit' ||
      fn === 'onOpen'
    ) {
      ScriptApp.deleteTrigger(trigger);
    }
  });

  // Use ONE installable edit trigger for automatic status updates.
  // This runs with the authorization of the account that created the trigger
  // and therefore works when other spreadsheet editors modify Data List.
  ScriptApp.newTrigger('validatorOnEdit')
    .forSpreadsheet(ss)
    .onEdit()
    .create();

  ScriptApp.newTrigger('validatorOnOpen')
    .forSpreadsheet(ss)
    .onOpen()
    .create();

  ScriptApp.newTrigger('validatorDailyRefresh')
    .timeBased()
    .everyDays(1)
    .atHour(0)
    .create();

  // One-time initial refresh only during setup.
  refreshAllStatuses_(sheet);

  ss.toast('Procurement validator installed and optimized.', 'Validator', 4);
}

/**
 * No simple onEdit trigger is used.
 *
 * Automatic status processing is handled exclusively by the installable
 * validatorOnEdit trigger created by setupValidator().
 *
 * Keeping only one edit trigger prevents duplicate status writes and makes
 * the behavior consistent for all spreadsheet editors.
 */

/**
 * No simple onEdit trigger is used.
 *
 * The installable validatorOnOpen trigger handles opening the spreadsheet.
 * No full refresh is performed by a simple trigger.
 */
function onOpen(e) {
  return;
}

/**
 * Installable open trigger.
 *
 * Important: it does NOT recalculate the entire sheet. This keeps spreadsheet
 * opening fast. Date-dependent changes are handled by the daily trigger and
 * actual edits are handled by validatorOnEdit.
 */
function validatorOnOpen(e) {
  // Intentionally do nothing.
  //
  // Recalculating every row during spreadsheet open was one of the main
  // causes of slow loading. Edits are handled by validatorOnEdit and
  // date-only status changes are handled by validatorDailyRefresh.
}

/**
 * Daily status refresh.
 *
 * This handles automatic changes caused solely by the date changing.
 * It cannot display a modal because it runs without an active editor UI.
 */
function validatorDailyRefresh() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss && ss.getSheetByName(CONFIG.SHEET_NAME);
    if (sheet) refreshStatusesBatch_(sheet);
  } catch (err) {
    console.error('validatorDailyRefresh error: ' + err);
  }
}

/**
 * Installable onEdit trigger.
 *
 * Only the affected rows are read and processed.
 */
function validatorOnEdit(e) {
  if (!e || !e.range) return;

  const range = e.range;
  const sheet = range.getSheet();

  if (sheet.getName() !== CONFIG.SHEET_NAME) return;
  if (range.getLastRow() <= CONFIG.HEADER_ROW) return;

  const lock = LockService.getDocumentLock();

  try {
    if (!lock.tryLock(CONFIG.LOCK_TIMEOUT_MS)) return;

    const headers = getHeadersCached_(sheet);
    const statusIndex = headers.indexOf(CONFIG.STATUS_HEADER);
    if (statusIndex < 0) return;

    const firstRow = Math.max(range.getRow(), CONFIG.HEADER_ROW + 1);
    const lastRow = range.getLastRow();

    const allErrors = [];
    let anyStatusChanged = false;

    for (let row = firstRow; row <= lastRow; row++) {
      const result = processSingleRowFast_(sheet, row, headers, statusIndex, true);
      if (result.statusChanged) anyStatusChanged = true;
      if (result.errors.length) {
        Array.prototype.push.apply(allErrors, result.errors);
      }
    }

    if (allErrors.length && anyStatusChanged) {
      try {
        showValidationModal_(allErrors);
      } catch (uiErr) {
        console.warn('Validation modal unavailable: ' + uiErr);
      }
    }
  } catch (err) {
    console.error('validatorOnEdit error: ' + err);
  } finally {
    try {
      lock.releaseLock();
    } catch (ignore) {}
  }
}

/**
 * Fast header lookup.
 *
 * Headers change rarely, so cache them briefly instead of reading row 1
 * from Sheets on every edit.
 */
function getHeadersCached_(sheet) {
  const cache = CacheService.getScriptCache();
  const key = 'validator_headers_' + sheet.getSheetId();
  const cached = cache.get(key);

  if (cached) {
    try {
      return JSON.parse(cached);
    } catch (ignore) {}
  }

  const headers = getHeaders_(sheet);
  cache.put(key, JSON.stringify(headers), 21600);
  return headers;
}

/**
 * Fast single-row status calculation.
 *
 * For an ordinary edit this performs:
 *   - one row read
 *   - one status write only when the status actually changes
 *
 * It never reads rows 1..N just because the edited row is large.
 */
function processSingleRowFast_(sheet, row, headers, statusIndex, collectErrors) {
  // Exactly one row read, regardless of whether this is Row 2 or Row 50,000.
  const rowRange = sheet.getRange(row, 1, 1, headers.length);
  const values = rowRange.getValues()[0];
  const displayValues = rowRange.getDisplayValues()[0];

  const data = {};
  const displayData = {};

  for (let c = 0; c < headers.length; c++) {
    const field = headers[c];
    if (!field) continue;
    data[field] = values[c];
    displayData[field] = displayValues[c];
  }

  const status = determineStatus_(data, displayData);
  const currentStatus = normalize_(displayData[CONFIG.STATUS_HEADER]);
  const statusChanged = currentStatus !== status;

  if (statusChanged) {
    sheet.getRange(row, statusIndex + 1).setValue(status);
  }

  let errors = [];

  if (collectErrors && status) {
    errors = validateRowFromData_(
      row,
      headers,
      data,
      displayData,
      status
    );
  }

  return {
    statusChanged: statusChanged,
    errors: errors
  };
}

/**
 * Process only rows touched by the edit.
 *
 * Reads all affected cells in one batch, calculates statuses in memory,
 * then writes the status column in one batch.
 */
function processEditedRows_(sheet, range, collectErrors) {
  const headers = getHeaders_(sheet);
  const statusIndex = headers.indexOf(CONFIG.STATUS_HEADER);

  if (statusIndex < 0) {
    return { errors: [], statusChanged: false };
  }

  const firstRow = Math.max(range.getRow(), CONFIG.HEADER_ROW + 1);
  const lastRow = Math.min(
    sheet.getLastRow(),
    range.getLastRow()
  );

  if (lastRow < firstRow) {
    return { errors: [], statusChanged: false };
  }

  const rowCount = lastRow - firstRow + 1;
  const rows = readRows_(sheet, firstRow, rowCount, headers.length, headers);

  const statusValues = [];
  const errors = [];
  let statusChanged = false;

  rows.forEach(function(rowInfo, offset) {
    const row = firstRow + offset;
    const data = rowInfo.data;
    const displayData = rowInfo.displayData;

    const status = determineStatus_(data, displayData);

    const current = normalize_(displayData[CONFIG.STATUS_HEADER]);

    statusValues.push([status]);

    if (current !== status) {
      statusChanged = true;
    }

    if (collectErrors && status) {
      const rowErrors = validateRowFromData_(
        row,
        headers,
        data,
        displayData,
        status
      );

      Array.prototype.push.apply(errors, rowErrors);
    }
  });

  // One write for the entire affected status range.
  if (statusChanged) {
    sheet
      .getRange(firstRow, statusIndex + 1, rowCount, 1)
      .setValues(statusValues);
  }

  return {
    errors: errors,
    statusChanged: statusChanged
  };
}

/**
 * Recalculate statuses in one batched read and one batched write.
 *
 * This is used by the daily refresh and setup. It avoids the old
 * row-by-row getRange/setValue pattern.
 */
function refreshStatusesBatch_(sheet) {
  if (!sheet || sheet.getName() !== CONFIG.SHEET_NAME) return;

  const headers = getHeaders_(sheet);
  const statusIndex = headers.indexOf(CONFIG.STATUS_HEADER);

  if (statusIndex < 0) return;

  const lastRow = sheet.getLastRow();
  if (lastRow <= CONFIG.HEADER_ROW) return;

  const rowCount = lastRow - CONFIG.HEADER_ROW;
  const rows = readRows_(
    sheet,
    CONFIG.HEADER_ROW + 1,
    rowCount,
    headers.length,
    headers
  );

  const statusValues = [];

  rows.forEach(function(rowInfo) {
    statusValues.push([
      determineStatus_(rowInfo.data, rowInfo.displayData)
    ]);
  });

  sheet
    .getRange(CONFIG.HEADER_ROW + 1, statusIndex + 1, rowCount, 1)
    .setValues(statusValues);
}

/**
 * Backward-compatible name used by setupValidator().
 */
function refreshAllStatuses_(sheet) {
  refreshStatusesBatch_(sheet);
}

/**
 * Read an entire affected block once.
 *
 * Both raw values and displayed values are captured in two batch reads.
 * No individual cell reads are performed during status calculation.
 */
function readRows_(sheet, startRow, rowCount, columnCount, headers) {
  const range = sheet.getRange(startRow, 1, rowCount, columnCount);

  const values = range.getValues();
  const displayValues = range.getDisplayValues();

  headers = headers || getHeaders_(sheet);
  const rows = [];

  for (let r = 0; r < rowCount; r++) {
    const data = {};
    const displayData = {};

    for (let c = 0; c < headers.length; c++) {
      const header = headers[c];
      if (!header) continue;

      data[header] = values[r][c];
      displayData[header] = displayValues[r][c];
    }

    rows.push({
      data: data,
      displayData: displayData
    });
  }

  return rows;
}

/**
 * Determine exactly one automatic status.
 *
 * Priority:
 * 1. REALIGNED ITEM
 * 2. CANCELLED PR
 * 3. PURCHASE ORDER
 * 4. CANCELLED PO
 * 5. AWARDED
 * 6. FAILED
 * 7. CLOSED
 * 8. ACTIVE
 * 9. blank
 */
function determineStatus_(data, displayData) {
  if (isCompletelyBlank_(data)) return '';

  // REALIGNED ITEM is independent of PhilGEPS.
  if (isRealignedItem_(data, displayData)) {
    return 'Realigned Item';
  }

  // All other automatic statuses require numeric PhilGEPS reference.
  if (!requiredPhilGEPSValid_(data, displayData)) return '';

  // CANCELLED PR.
  if (
    isZero_(data['PR TOTAL ABC'], displayData['PR TOTAL ABC']) &&
    /cancel+ed\s+pr/i.test(normalize_(data['REMARKS']))
  ) {
    return 'Cancelled PR';
  }

  // PURCHASE ORDER.
  if (isPurchaseOrderReady_(data)) {
    return 'Purchase Order';
  }

  // CANCELLED PO.
  if (isCancelledPOReady_(data)) {
    return 'Cancelled PO';
  }

  // AWARDED.
  if (fieldsComplete_(data, AWARDED_FIELDS)) {
    if (downstreamDatesBeforeToday_(data)) return 'Awarded';
  }

  // FAILED deliberately does NOT require Supplier, Project ID,
  // Procurement Method, or Project Title.
  if (fieldsComplete_(data, FAILED_FIELDS)) {
    if (downstreamDatesBeforeToday_(data)) return 'Failed';
  }

  // CLOSED / ACTIVE.
  if (fieldsComplete_(data, CORE_FIELDS)) {
    const eligibility = getDate_(data['ELIGIBILITY SCREENING']);
    const submission = getDate_(data['SUBMISSION OF BIDS']);

    if (
      eligibility &&
      submission &&
      isBeforeToday_(eligibility) &&
      isBeforeToday_(submission)
    ) {
      return 'Closed';
    }

    if (
      (eligibility && !isBeforeToday_(eligibility)) ||
      (submission && !isBeforeToday_(submission))
    ) {
      return 'Active';
    }
  }

  return '';
}

function isRealignedItem_(data, displayData) {
  const totalAbc = getNumber_(
    data['TOTAL ABC'],
    displayData['TOTAL ABC']
  );

  const remarks = normalize_(
    data['REMARKS'] || displayData['REMARKS']
  );

  return (
    totalAbc !== null &&
    totalAbc === 0 &&
    /\brealign\w*\b/i.test(remarks)
  );
}

function isPurchaseOrderReady_(data) {
  if (!fieldsComplete_(data, PO_FIELDS)) return false;

  const totalAbc = getNumber_(data['TOTAL ABC']);
  const prTotalAbc = getNumber_(data['PR TOTAL ABC']);
  const poTotalCost = getNumber_(data['PO TOTAL COST']);

  return (
    totalAbc !== null &&
    totalAbc === 0 &&
    prTotalAbc !== null &&
    prTotalAbc === 0 &&
    poTotalCost !== null &&
    poTotalCost > 0
  );
}

function isCancelledPOReady_(data) {
  if (!fieldsComplete_(data, PO_FIELDS)) return false;

  const totalAbc = getNumber_(data['TOTAL ABC']);
  const prTotalAbc = getNumber_(data['PR TOTAL ABC']);
  const poTotalCost = getNumber_(data['PO TOTAL COST']);

  return (
    totalAbc !== null &&
    totalAbc === 0 &&
    prTotalAbc !== null &&
    prTotalAbc === 0 &&
    poTotalCost !== null &&
    poTotalCost === 0
  );
}

function requiredPhilGEPSValid_(data, displayData) {
  return hasValue_(data[PHILGEPS_REQUIRED_FIELD]) &&
    isNumeric_(
      data[PHILGEPS_REQUIRED_FIELD],
      displayData[PHILGEPS_REQUIRED_FIELD]
    );
}

function downstreamDatesBeforeToday_(data) {
  const eligibility = getDate_(data['ELIGIBILITY SCREENING']);
  const submission = getDate_(data['SUBMISSION OF BIDS']);

  return !!(
    eligibility &&
    submission &&
    isBeforeToday_(eligibility) &&
    isBeforeToday_(submission)
  );
}

/**
 * Status-specific validation using already-loaded row data.
 *
 * No Spreadsheet service calls occur here.
 */
function validateRowFromData_(row, headers, data, displayData, status) {
  const errors = [];
  const required = getRequiredFields_(status);

  required.forEach(function(field) {
    if (!Object.prototype.hasOwnProperty.call(data, field)) return;

    const value = data[field];
    const display = displayData[field];

    if (isBlank_(value, display)) {
      errors.push({
        row: row,
        status: status,
        field: field,
        message: 'This field is required for status "' + status + '".'
      });
      return;
    }

    const formatError = validateFieldFormat_(field, value, display);

    if (formatError) {
      errors.push({
        row: row,
        status: status,
        field: field,
        message: formatError
      });
    }
  });

  // Validate entered non-required fields too.
  headers.forEach(function(field) {
    if (!field || field === CONFIG.STATUS_HEADER) return;

    const value = data[field];
    const display = displayData[field];

    if (isBlank_(value, display)) return;

    const formatError = validateFieldFormat_(field, value, display);

    if (formatError) {
      const already = errors.some(function(error) {
        return error.field === field;
      });

      if (!already) {
        errors.push({
          row: row,
          status: status,
          field: field,
          message: formatError
        });
      }
    }
  });

  return errors;
}

/**
 * Backward-compatible manual validation helper.
 */
function validateRow_(sheet, row, headers, status) {
  const rowInfo = readRows_(sheet, row, 1, headers.length, headers)[0];

  return validateRowFromData_(
    row,
    headers,
    rowInfo.data,
    rowInfo.displayData,
    status
  );
}

function getRequiredFields_(status) {
  switch (status) {
    case 'Active':
    case 'Closed':
      return CORE_FIELDS;

    case 'Awarded':
      return AWARDED_FIELDS;

    case 'Failed':
      return FAILED_FIELDS;

    case 'Purchase Order':
    case 'Cancelled PO':
      return PO_FIELDS;

    case 'Cancelled PR':
      return [
        PHILGEPS_REQUIRED_FIELD,
        'PR NO.',
        'PR TOTAL ABC',
        'REMARKS'
      ];

    case 'Realigned Item':
      return ['TOTAL ABC', 'REMARKS'];

    default:
      return [];
  }
}

function validateFieldFormat_(field, value, display) {
  if (isBlank_(value, display)) return null;

  if (DATE_FIELDS.indexOf(field) >= 0) {
    if (!isValidDate_(value, display)) {
      return 'Invalid date format. Expected format: ' +
        CONFIG.DATE_FORMAT + '.';
    }

    return null;
  }

  if (NUMERIC_FIELDS.indexOf(field) >= 0) {
    if (!isNumeric_(value, display)) {
      return 'Invalid number format. This field must contain a numeric value.';
    }

    return null;
  }

  if (field === 'PO NO.') {
    if (!/^[A-Za-z0-9\-\/_ .]+$/.test(display)) {
      return 'Invalid PO number. Use letters, numbers, hyphens, slashes, underscores or periods only.';
    }
  }

  return null;
}

function fieldsComplete_(data, fields) {
  return fields.every(function(field) {
    return hasValue_(data[field]);
  });
}

function getHeaders_(sheet) {
  const lastColumn = sheet.getLastColumn();
  if (lastColumn < 1) return [];

  return sheet
    .getRange(CONFIG.HEADER_ROW, 1, 1, lastColumn)
    .getDisplayValues()[0]
    .map(normalizeHeader_);
}

function normalizeHeader_(value) {
  if (value === null || value === undefined) return '';

  return String(value)
    .replace(/\s+/g, ' ')
    .trim()
    .toUpperCase();
}

function hasValue_(value) {
  if (value === null || value === undefined) return false;

  if (typeof value === 'string') {
    return value.trim() !== '';
  }

  if (Object.prototype.toString.call(value) === '[object Date]') {
    return !isNaN(value.getTime());
  }

  return true;
}

function isBlank_(value, display) {
  if (value === null || value === undefined) return true;

  if (typeof value === 'string' && value.trim() === '') {
    return true;
  }

  if (
    display !== undefined &&
    String(display).trim() === ''
  ) {
    return true;
  }

  return false;
}

function isCompletelyBlank_(data) {
  return Object.keys(data).every(function(field) {
    return field === CONFIG.STATUS_HEADER || !hasValue_(data[field]);
  });
}

function normalize_(value) {
  if (value === null || value === undefined) return '';
  return String(value).trim();
}

function getDate_(value) {
  if (
    Object.prototype.toString.call(value) === '[object Date]' &&
    !isNaN(value.getTime())
  ) {
    return new Date(
      value.getFullYear(),
      value.getMonth(),
      value.getDate()
    );
  }

  const text = normalize_(value);

  if (!text || /^n\/?a$/i.test(text)) return null;

  const m = text.match(
    /^(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2}),\s+(\d{4})$/i
  );

  if (!m) return null;

  const months = [
    'january',
    'february',
    'march',
    'april',
    'may',
    'june',
    'july',
    'august',
    'september',
    'october',
    'november',
    'december'
  ];

  const month = months.indexOf(m[1].toLowerCase());
  const day = Number(m[2]);
  const year = Number(m[3]);

  const date = new Date(year, month, day);

  if (
    date.getFullYear() === year &&
    date.getMonth() === month &&
    date.getDate() === day
  ) {
    return date;
  }

  return null;
}

function isValidDate_(value, display) {
  if (
    Object.prototype.toString.call(value) === '[object Date]' &&
    !isNaN(value.getTime())
  ) {
    return true;
  }

  if (/^n\/?a$/i.test(normalize_(display))) return true;

  return !!getDate_(display);
}

function normalizeDate_(date) {
  return new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate()
  );
}

function isBeforeToday_(date) {
  const d = normalizeDate_(date);
  const today = normalizeDate_(new Date());

  return d.getTime() < today.getTime();
}

function getNumber_(value, display) {
  if (typeof value === 'number' && !isNaN(value)) {
    return value;
  }

  const raw = normalize_(value);
  const shown = normalize_(display);

  const text = (raw || shown)
    .replace(/,/g, '')
    .replace(/\s/g, '');

  if (!/^-?\d+(\.\d+)?$/.test(text)) return null;

  return Number(text);
}

function isNumeric_(value, display) {
  return getNumber_(value, display) !== null;
}

function isZero_(value, display) {
  const n = getNumber_(value, display);
  return n !== null && n === 0;
}

/**
 * Validation modal.
 */
function showValidationModal_(errors) {
  const shown = errors.slice(0, CONFIG.MAX_ERRORS_DISPLAYED);

  let html =
    '<!doctype html><html><head><base target="_top">' +
    '<style>' +
    'body{font-family:Arial,sans-serif;margin:0;background:#f5f7fa;color:#202124}' +
    '.wrap{padding:22px}' +
    '.head{background:#b3261e;color:#fff;margin:-22px -22px 18px;padding:18px 22px}' +
    '.head h2{margin:0 0 6px;font-size:20px}' +
    '.head p{margin:0;font-size:13px}' +
    '.summary{background:#fff;border-left:5px solid #b3261e;padding:12px 15px;margin-bottom:14px}' +
    '.scroll{max-height:390px;overflow:auto}' +
    '.error{background:#fff;border:1px solid #dadce0;border-radius:5px;padding:12px 14px;margin-bottom:9px}' +
    '.meta{font-size:12px;color:#5f6368;margin-bottom:5px}' +
    '.field{font-weight:bold;color:#b3261e;margin-bottom:4px}' +
    '.msg{font-size:13px;line-height:1.4}' +
    '.footer{text-align:right;margin-top:16px}' +
    'button{border:0;border-radius:5px;padding:9px 20px;background:#1a73e8;color:#fff;cursor:pointer}' +
    '</style></head><body><div class="wrap">' +
    '<div class="head"><h2>⚠ Procurement Data Validation Error</h2>' +
    '<p>Please correct the following field(s).</p></div>' +
    '<div class="summary"><strong>' +
    errors.length +
    ' validation error' +
    (errors.length === 1 ? '' : 's') +
    ' found.</strong></div><div class="scroll">';

  shown.forEach(function(error) {
    html +=
      '<div class="error">' +
      '<div class="meta">Row ' +
      escapeHtml_(error.row) +
      ' &nbsp;|&nbsp; Status: ' +
      escapeHtml_(error.status) +
      '</div>' +
      '<div class="field">' +
      escapeHtml_(error.field) +
      '</div>' +
      '<div class="msg">' +
      escapeHtml_(error.message) +
      '</div></div>';
  });

  if (errors.length > shown.length) {
    html +=
      '<div class="error"><div class="msg">Only the first ' +
      shown.length +
      ' errors are displayed.</div></div>';
  }

  html +=
    '</div><div class="footer">' +
    '<button onclick="google.script.host.close()">Close</button>' +
    '</div></div></body></html>';

  SpreadsheetApp.getUi().showModalDialog(
    HtmlService.createHtmlOutput(html)
      .setWidth(650)
      .setHeight(560),
    'Data Validation'
  );
}

function escapeHtml_(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

/**
 * Optional manual test: validates the currently selected row.
 */
function validateActiveRow() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();

  if (!sheet || sheet.getName() !== CONFIG.SHEET_NAME) {
    SpreadsheetApp.getUi().alert(
      'This validator only runs on the "Data List" sheet.'
    );
    return;
  }

  const row = sheet.getActiveRange().getRow();

  if (row <= CONFIG.HEADER_ROW) return;

  const headers = getHeaders_(sheet);
  const statusIndex = headers.indexOf(CONFIG.STATUS_HEADER);

  if (statusIndex < 0) return;

  const rowInfo = readRows_(sheet, row, 1, headers.length)[0];
  const status = normalize_(
    rowInfo.displayData[CONFIG.STATUS_HEADER]
  );

  if (!status) return;

  const errors = validateRowFromData_(
    row,
    headers,
    rowInfo.data,
    rowInfo.displayData,
    status
  );

  if (errors.length) {
    showValidationModal_(errors);
  } else {
    ss.toast('No validation errors found.', 'Validation', 3);
  }
}
